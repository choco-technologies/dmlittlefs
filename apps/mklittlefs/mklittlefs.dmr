# DMOD Resource File for mklittlefs
# This file specifies where resources should be installed

# === Core Module ===
dmf=./${module}.dmf => ${destination}/${module}.dmf [origin=${dmf_dir}/${module}.dmf]
dmfc=./${module}.dmfc => ${destination}/${module}.dmfc [origin=${build_dir}/dmfc/${module}.dmfc]
dmd=./${module}.dmd => ${destination}/${module}.dmd [origin=${dmf_dir}/${module}.dmd]
version=./${module}_version.txt => ${destination}/${module}_version.txt [origin=${dmf_dir}/${module}_version.txt]

# === Documentation ===
# NOTE: ${repo_dir} is the top-level repo root (mklittlefs is built through
# add_subdirectory() from dmfatfs's CMakeLists.txt), so paths are relative to
# the repo root, not to apps/mklittlefs.
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/apps/mklittlefs/README.md]

# === License ===
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./${module}.dmr => ${destination}/${module}/${module}.dmr [origin=${repo_dir}/apps/mklittlefs/${module}.dmr]
