# Include dynamically generated versions list from latest release
$include https://github.com/choco-technologies/dmlittlefs/releases/download/vlatest/versions.dmm

# Module entry with version placeholder - expanded by $version-available
dmlittlefs https://github.com/choco-technologies/dmlittlefs/releases/download/v<version>/dmlittlefs-v<version>-<arch_name>.zip

# mklittlefs - command line front end of dmlittlefs_mkfs() (apps/mklittlefs), built
# and released together with dmlittlefs
mklittlefs https://github.com/choco-technologies/dmlittlefs/releases/download/v<version>/mklittlefs-v<version>-<arch_name>.zip
